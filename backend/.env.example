# ---------------------------------------------------------------------------
# UniFind backend configuration
# Copy this file to `.env` for local development, or set these as environment
# variables on your host (Render, etc.). Real env vars always take precedence.
# ---------------------------------------------------------------------------

# DEBUG=True is for LOCAL development only. This file is the template you copy
# to `.env` for local work. Production hosts (e.g. Render) set DEBUG=False in
# their own environment, which turns on HTTPS redirect and secure cookies.
DEBUG=True

# Django secret key. Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Comma-separated hostnames the backend will serve (no scheme).
# On Render, RENDER_EXTERNAL_HOSTNAME is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string for production. If unset, SQLite is used locally.
#   e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=
# DB_SSL_REQUIRE=True

# Comma-separated frontend origins allowed to call the API (scheme + host).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex origins, e.g. preview deployments:
#   CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# Origins trusted for CSRF (needed for the Django admin / browsable API over HTTPS).
# CSRF_TRUSTED_ORIGINS=https://your-backend.onrender.com

# Cloudinary media storage (required for persistent uploads in production).
# Easiest: paste the single CLOUDINARY_URL from your Cloudinary dashboard.
#   CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or set the three parts individually:
#   CLOUDINARY_CLOUD_NAME=
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=

# Force HTTPS redirect in production (default True when DEBUG is False).
# SECURE_SSL_REDIRECT=True
